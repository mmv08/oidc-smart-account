# Reference deployment only. Never commit a funded private key.
DEPLOYER_PRIVATE_KEY=

# Use an audited TimelockController/multisig address in production.
# Ownable2Step contracts require this address to call acceptOwnership after deployment.
GOVERNANCE_OWNER=

# ERC-4337 EntryPoint deployed on the target chain.
ENTRY_POINT=

# Comma-separated, strictly ascending attestor addresses. Production target: independent 2-of-3.
ATTESTORS=
ATTESTOR_THRESHOLD=2

# Seconds. Suggested policy values must be chosen from an audited operational threat model.
MAX_ATTESTATION_TTL=3600
RECOVERY_DELAY=604800
RECOVERY_WINDOW=604800
