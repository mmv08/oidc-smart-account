# Reference deployment only. Never commit a funded private key.
DEPLOYER_PRIVATE_KEY=
RPC_URL=

# Deployed IOIDCClaimVerifier adapter. This can be the included GoogleJWTVerifier or
# another independently reviewed proof adapter.
OIDC_CLAIM_VERIFIER=

# TEE-backed Google JWT adapter. The official deployment starts without an attestor;
# threshold governance enrolls one only after the published Nitro ceremony.
TEE_GOVERNANCE=
TEE_GUARDIAN=
TEE_ATTESTOR_ROTATION_DELAY=172800
TEE_MAX_OBSERVATION_AGE=900
TEE_MAX_REGISTRY_STALENESS=86400
GOOGLE_CLIENT_ID=
GOOGLE_AUTHORIZED_PARTY=

# Example values only; choose and review these for the target product.
RECOVERY_DELAY=172800
RECOVERY_WINDOW=604800
MAX_CLAIM_AGE=600
