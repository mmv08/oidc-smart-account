# Reference deployment only. Never commit a funded private key.
DEPLOYER_PRIVATE_KEY=
RPC_URL=

# Deployed IOIDCClaimVerifier adapter. This can be the included GoogleJWTVerifier or
# another independently reviewed proof adapter.
OIDC_CLAIM_VERIFIER=

# Direct Google JWT adapter deployment. GOOGLE_KEY_UPDATER is an explicit recovery trust root.
GOOGLE_KEY_UPDATER=
GOOGLE_CLIENT_ID=
GOOGLE_AUTHORIZED_PARTY=

# Example values only; choose and review these for the target product.
RECOVERY_DELAY=172800
RECOVERY_WINDOW=604800
MAX_CLAIM_AGE=600
