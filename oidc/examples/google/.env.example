# Google Cloud OAuth web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/callback

# Exact deployed protocol/action state
CHAIN_ID=1
RECOVERY_CONTROLLER_ADDRESS=
ACCOUNT_ADDRESS=
EXPECTED_SIGNER_HASH=
EXPECTED_SIGNER_EPOCH=
NEW_SIGNER_HASH=
RECOVERY_NONCE=

# Original private account identity salt; never commit the populated .env file.
IDENTITY_SALT=

PORT=8787
REQUEST_LIFETIME_SECONDS=600
MAX_CLAIM_AGE_SECONDS=600
