{
  "name": "oidc-onchain-identity-model",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/integration/*.e2e.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "example:google": "tsx examples/google/server.ts"
  },
  "dependencies": {
    "viem": "2.55.10"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "jose": "6.2.7",
    "oidc-provider": "9.11.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
