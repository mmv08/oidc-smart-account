# Local reference server only. This opts into volatile in-memory storage.
# Production must inject durable transactional storage instead.
ALLOW_IN_MEMORY_STORAGE=true
HOST=127.0.0.1
PORT=3000

# Public HTTPS origin. Set ALLOW_INSECURE_HTTP=true only for isolated local testing.
PUBLIC_ORIGIN=https://attestor.example
ALLOW_INSECURE_HTTP=false

# Attestor ECDSA key. Never commit or share a real value.
ATTESTOR_PRIVATE_KEY=
ATTESTOR_EPOCH=1

# Exact deployed contracts and chain policy.
CHAIN_ID=
EIP712_VERIFYING_CONTRACT=
FACTORY_ADDRESS=
RECOVERY_MANAGER_ADDRESS=
RECOVERY_DELAY_SECONDS=604800
MAX_ATTESTATION_TTL_SECONDS=3600

CHALLENGE_TTL_SECONDS=300
MAX_AUTH_AGE_SECONDS=600
JWKS_CACHE_SECONDS=300
CLOCK_TOLERANCE_SECONDS=10

# Google OAuth/OIDC application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_POLICY=google-client-policy-v1
GOOGLE_REVOKED_KEY_THUMBPRINTS=
# GOOGLE_ISSUER=https://accounts.google.com
# GOOGLE_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
# GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# Apple Services ID and generated client-secret JWT.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_POLICY=apple-client-policy-v1
APPLE_REVOKED_KEY_THUMBPRINTS=
# APPLE_ISSUER=https://appleid.apple.com
# APPLE_AUTHORIZATION_ENDPOINT=https://appleid.apple.com/auth/authorize
# APPLE_TOKEN_ENDPOINT=https://appleid.apple.com/auth/token
# APPLE_JWKS_URI=https://appleid.apple.com/auth/keys
